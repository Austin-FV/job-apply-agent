<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ personal.full_name }} — Resume</title>
<link rel="stylesheet" href="styles.css">
</head>
<body class="resume">

<header class="resume-header">
  <h1>{{ personal.full_name }}</h1>
  <p class="contact">
    {{ personal.phone }} &nbsp;|&nbsp;
    <a href="mailto:{{ personal.email }}">{{ personal.email }}</a>
    {% if personal.links.linkedin %} &nbsp;|&nbsp; <a href="{{ personal.links.linkedin }}">{{ personal.links.linkedin | replace("https://", "") | replace("http://", "") }}</a>{% endif %}
    {% if personal.links.github %} &nbsp;|&nbsp; <a href="{{ personal.links.github }}">{{ personal.links.github | replace("https://", "") | replace("http://", "") }}</a>{% endif %}
    {% if personal.links.portfolio %} &nbsp;|&nbsp; <a href="{{ personal.links.portfolio }}">{{ personal.links.portfolio | replace("https://", "") | replace("http://", "") }}</a>{% endif %}
  </p>
</header>

<section>
  <h2>Education</h2>
  {% for edu in resume.education %}
  <article class="entry">
    <div class="row">
      <strong>{{ edu.school }}</strong>
      <span class="meta">{{ edu.location }}</span>
    </div>
    <div class="row">
      <em>{{ edu.degree }}</em>
      <span class="meta">{{ edu.start }} – {{ edu.end }}</span>
    </div>
    {% if edu.honors or edu.relevant_courses %}
    <ul>
      {% if edu.honors %}<li><strong>Achievements:</strong> {{ edu.honors | join(" — ") }}</li>{% endif %}
      {% if edu.relevant_courses %}<li><strong>Relevant Courses:</strong> {{ edu.relevant_courses | join(", ") }}</li>{% endif %}
    </ul>
    {% endif %}
  </article>
  {% endfor %}
</section>

<section>
  <h2>Technical Skills</h2>
  <div class="skills">
    {% for group, items in resume.skills_grouped.items() %}
    <p><strong>{{ group }}:</strong> {{ items | join(", ") }}</p>
    {% endfor %}
  </div>
</section>

<section>
  <h2>Experience</h2>
  {% for exp in resume.experience %}
  <article class="entry">
    <div class="row">
      <strong>{{ exp.title }}</strong>
      <span class="meta">{{ exp.start }} – {{ exp.end }}</span>
    </div>
    <div class="row">
      <em>{{ exp.company }}</em>
      <span class="meta">{{ exp.location }}</span>
    </div>
    <ul>
      {% for b in exp.bullets %}<li>{{ b.text }}</li>{% endfor %}
    </ul>
  </article>
  {% endfor %}
</section>

{% if resume.projects %}
<section>
  <h2>Projects</h2>
  {% for proj in resume.projects %}
  <article class="entry">
    <div class="row">
      <span>
        <strong>{% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}</strong>
        &nbsp;|&nbsp; <em>{{ proj.tech | join(", ") }}</em>
      </span>
      <span class="meta">{# project dates intentionally omitted; LLM doesn't pass them #}</span>
    </div>
    <ul>
      {% for b in proj.bullets %}<li>{{ b.text }}</li>{% endfor %}
    </ul>
  </article>
  {% endfor %}
</section>
{% endif %}

</body>
</html>
