# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model for resume + cover letter generation (quality matters here).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Separate knob for the browser-use form-fill agent. Override to experiment.
ANTHROPIC_FILL_MODEL=claude-sonnet-4-6

# Set true to run the form-fill browser without a visible window.
BROWSER_USE_HEADLESS=false

# Seconds to trim off the front of the recorded form-fill video. Covers the
# browser launch + Chrome new-tab lead-in before the agent's first navigation.
# Bump if your runs still show loading-screen content at the start.
VIDEO_INTRO_TRIM_SECONDS=5.0

LOG_LEVEL=INFO
